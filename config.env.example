# ==============================
# Mongo Upgrade Tool - CONFIG TEMPLATE
# ==============================
# INSTRUCTIONS: Copy this file to 'config.env' and edit the values below.

# ---------- General ----------
# Options: docker (for replica sets) or systemd (for host-based installs)
MODE=docker

LOG_FILE=/var/log/mongodb-upgrade/upgrade.log
STATE_DIR=/var/lib/mongodb-upgrade
BACKUP_DIR=/var/backups/mongodb

# ---------- Docker Replica ----------
COMPOSE_FILE=./scripts/replica/docker-compose.yml
MONGO1=mongo1
MONGO2=mongo2
MONGO3=mongo3
RS_NAME=rs0

# ---------- Authentication ----------
# If true, the tool will use the credentials below for all operations
AUTH_ENABLED=true
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASS=YOUR_SECURE_PASSWORD_HERE
MONGO_AUTH_DB=admin

# ---------- Validation Settings ----------
VALIDATE_WRITE_TEST=false
VALIDATE_INDEX_CHECK=true
VALIDATE_COLLECTION_CHECK=true
VALIDATE_LOG_CHECK=true

# ---------- Safety Limits ----------
MIN_DISK_GB=5
MAX_LOG_ERROR_LINES=30
